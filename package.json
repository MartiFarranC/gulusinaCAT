{
  "name": "gulusinacat",
  "version": "1.0.0",
  "private": true,
  "description": "Comparador de preus de les benzineres de Catalunya per marca",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.4",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  }
}
