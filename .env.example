# Variables d'entorn opcionals dels scripts de dades. Cap no és secreta.

# actualitza_preus.py: quants dies passats cal recuperar a historic.json amb
# l'històric del Ministeri (0 = només el dia d'avui).
DIES_ENRERE=0

# historic_anual.py: quants mesos pendents es demanen al Ministeri en una
# sola execució.
MAX_PETICIONS=30
