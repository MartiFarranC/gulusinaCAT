# Variables d'entorn opcionals de les tasques de dades. Cap no és secreta.

# `gulusinacat preus`: quants dies passats cal recuperar a historic.json amb
# l'històric del Ministeri (0 = només el dia d'avui).
DIES_ENRERE=0

# `gulusinacat anual`: quants mesos pendents es demanen al Ministeri en una
# sola execució.
MAX_PETICIONS=30
